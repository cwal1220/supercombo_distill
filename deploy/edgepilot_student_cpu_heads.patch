@@ -0,0 +1,127 @@
+// CPU 헤드 코어(학생 모델)의 .heads 파일 읽기, 헤드 선형층 계산, 헤드가 2576 레이아웃을 빈틈없이 채우는지.
+#include "model/cpu_heads.h"
+
+#include "model/model_output_assembly.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct TestHead {
+    std::string name;
+    int in;
+    int out;
+};
+
+void put_u32(std::string &b, uint32_t v) {
+    for (int i = 0; i < 4; ++i) b.push_back(static_cast<char>((v >> (8 * i)) & 0xff));
+}
+
+void put_f32(std::string &b, float v) {
+    char c[4];
+    std::memcpy(c, &v, 4);
+    b.append(c, 4);
+}
+
+// W[o][i] = (o + 1) * 0.01 + i * 0.001, b[o] = -o
+std::string heads_bytes(const std::vector<TestHead> &heads) {
+    std::string b = "EPHEADS1";
+    put_u32(b, static_cast<uint32_t>(heads.size()));
+    for (const TestHead &h : heads) {
+        std::string name = h.name;
+        name.resize(32, '\0');
+        b += name;
+        put_u32(b, static_cast<uint32_t>(h.in));
+        put_u32(b, static_cast<uint32_t>(h.out));
+        for (int o = 0; o < h.out; ++o)
+            for (int i = 0; i < h.in; ++i) put_f32(b, (o + 1) * 0.01f + i * 0.001f);
+        for (int o = 0; o < h.out; ++o) put_f32(b, -static_cast<float>(o));
+    }
+    return b;
+}
+
+std::string write_temp(const std::string &bytes) {
+    char path[] = "/tmp/gtest_cpu_heads_XXXXXX";
+    const int fd = mkstemp(path);
+    EXPECT_GE(fd, 0);
+    std::FILE *f = fdopen(fd, "wb");
+    std::fwrite(bytes.data(), 1, bytes.size(), f);
+    std::fclose(f);
+    return path;
+}
+
+TEST(CpuHeads, LoadsAndApplies) {
+    const std::string path = write_temp(heads_bytes({{"plan", 6, 3}, {"lead_prob", 5, 2}}));
+    const CpuHeads heads(path);
+    std::remove(path.c_str());
+    ASSERT_EQ(heads.heads().size(), 2u);
+    const CpuHeads::Head *plan = heads.find("plan");
+    ASSERT_NE(plan, nullptr);
+    EXPECT_EQ(plan->in, 6);
+    EXPECT_EQ(plan->out, 3);
+    EXPECT_EQ(heads.find("lanes"), nullptr);
+
+    const float x[6] = {1.0f, -2.0f, 0.5f, 3.0f, 0.0f, 4.0f};
+    float y[3];
+    CpuHeads::apply(*plan, x, y);
+    for (int o = 0; o < 3; ++o) {
+        double want = -o;
+        for (int i = 0; i < 6; ++i) want += ((o + 1) * 0.01 + i * 0.001) * x[i];
+        EXPECT_NEAR(y[o], want, 1e-5);
+    }
+}
+
+TEST(CpuHeads, RejectsBadFiles) {
+    const std::string good = heads_bytes({{"plan", 4, 2}});
+    std::string bad_magic = good;
+    bad_magic[7] = '2';
+    const std::string cases[] = {
+        bad_magic,
+        good.substr(0, good.size() - 1),                // 잘림
+        good + "x",                                     // 남는 바이트
+        heads_bytes({{"plan", 4, 2}, {"plan", 4, 2}}),  // 같은 이름 두 번
+        heads_bytes({{"", 4, 2}}),                      // 빈 이름
+        heads_bytes({{"plan", 0, 2}}),                  // 폭 0
+    };
+    for (const std::string &bytes : cases) {
+        const std::string path = write_temp(bytes);
+        EXPECT_THROW(CpuHeads heads(path), std::runtime_error);
+        std::remove(path.c_str());
+    }
+    EXPECT_THROW(CpuHeads heads("/nonexistent/student.heads"), std::runtime_error);
+}
+
+TEST(CpuHeads, RejectsNonFiniteWeights) {
+    std::string bytes = heads_bytes({{"pose", 2, 1}});
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    std::memcpy(&bytes[bytes.size() - 4], &nan, 4);  // bias
+    const std::string path = write_temp(bytes);
+    EXPECT_THROW(CpuHeads heads(path), std::runtime_error);
+    std::remove(path.c_str());
+}
+
+TEST(CpuHeads, PathNextToTheAxmodel) {
+    EXPECT_EQ(cpu_heads_path("/root/edgepilot/models/lrg_calL.axmodel"), "/root/edgepilot/models/lrg_calL.heads");
+    EXPECT_EQ(cpu_heads_path("models/student"), "models/student.heads");
+}
+
+// 헤드 칸과 특징 칸이 2576 레이아웃의 앞쪽 kModelOutputFloats - 패딩을 겹침 없이 정확히 한 번씩 채운다.
+TEST(CpuHeads, PartsTileTheLayout) {
+    std::vector<int> hits(kModelOutputFloats, 0);
+    for (const auto &part : model_output_assembly::kCpuHeadParts)
+        for (int i = 0; i < part.count; ++i) ++hits[part.offset + i];
+    for (int i = 0; i < kModelFeatureLen; ++i) ++hits[model_output_layout::kFeatureOffset + i];
+    for (int i = 0; i < kModelOutputFloats; ++i)
+        EXPECT_EQ(hits[i], i < kModelOutputFloats - model_output_layout::kOutputPadding ? 1 : 0) << "at " << i;
+}
+
+}  // namespace
