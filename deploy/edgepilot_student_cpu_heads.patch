+#pragma once
+
+// CPU 헤드 코어(supercombo_distill의 학생 모델)의 헤드별 마지막 선형층. NPU는 헤드마다 마지막 ReLU 특징
+// hx_<head>와 out_hidden만 내고, 각 헤드의 y = W x + b는 여기서 fp32로 계산해 openpilot 2576 레이아웃의
+// 제자리(model_output_assembly.h kCpuHeadParts)에 쓴다. U16 출력 양자화가 plan yaw 같은 작은 값을 뭉개지
+// 않도록 마지막 층을 CPU에 둔 구조다.
+//
+// 가중치는 axmodel 옆의 같은 이름 .heads 파일에 있다(cpu_heads_path). 형식(little-endian):
+//   "EPHEADS1", u32 헤드 수, 헤드마다 char 이름[32](NUL로 채움), u32 입력 폭, u32 출력 폭,
+//   f32 W[출력][입력](행 우선), f32 b[출력]
+// 만드는 쪽은 supercombo_distill의 scripts/export_cpu_heads.py다. axengine에 의존하지 않아 호스트 검사가 본다.
+
+#include <string>
+#include <vector>
+
+class CpuHeads {
+public:
+    struct Head {
+        std::string name;
+        int in = 0;
+        int out = 0;
+        std::vector<float> weight;  // [out][in]
+        std::vector<float> bias;    // [out]
+    };
+
+    // 파일을 읽고 형식을 검사한다. 읽을 수 없거나 형식이 다르면 std::runtime_error.
+    explicit CpuHeads(const std::string &path);
+
+    const std::vector<Head> &heads() const { return heads_; }
+    // 이름으로 찾는다. 없으면 nullptr.
+    const Head *find(const std::string &name) const;
+
+    // y[out] = W x[in] + b
+    static void apply(const Head &head, const float *x, float *y);
+
+private:
+    std::vector<Head> heads_;
+};
+
+// "<dir>/<name>.axmodel"의 가중치 파일 "<dir>/<name>.heads". 확장자가 .axmodel이 아니면 끝에 .heads를 붙인다.
+std::string cpu_heads_path(const std::string &axmodel_path);
